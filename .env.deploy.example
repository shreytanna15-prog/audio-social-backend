# Copy to .env.deploy and fill in (never commit .env.deploy).
# Person X = Vercel Hobby project owner / GitHub account that is allowed to deploy.

DEPLOY_GH_TOKEN=ghp_your_person_x_github_pat_here
DEPLOY_GIT_NAME=Person X Name
DEPLOY_GIT_EMAIL=person-x@users.noreply.github.com

# Optional
DEPLOY_BRANCH=main
DEPLOY_REMOTE=origin
