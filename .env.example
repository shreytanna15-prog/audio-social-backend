DATABASE_URL=
DIRECT_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Chat realtime (Cloudflare Worker) — optional; REST chat works without these.
# Local Worker: workers/chat-realtime → npm run dev → http://127.0.0.1:8787
# Deployed: https://chat-realtime.<subdomain>.workers.dev
# Set BOTH URL + NOTIFY_SECRET together, or leave both empty.
REALTIME_WORKER_URL=
REALTIME_NOTIFY_SECRET=
# Must match Worker secret REALTIME_TOKEN_SECRET (defaults to JWT_ACCESS_SECRET)
REALTIME_TOKEN_SECRET=

# Cloudflare R2 — profile avatar/cover only (tracks/chat stay on Supabase)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Resend — forgot-password email OTP (swap provider via email adapter later)
# Until vibeogram.com is verified on Resend, use: VibeOGram <onboarding@resend.dev>
# (test mode can only deliver to your Resend account email)
RESEND_API_KEY=
EMAIL_FROM=VibeOGram <onboarding@resend.dev>

