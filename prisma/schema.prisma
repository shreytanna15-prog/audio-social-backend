generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  email              String    @unique
  username           String    @unique
  password           String
  name               String?
  bio                String?
  avatarPath         String?
  coverPath          String?
  usernameChangedAt  DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tracks             Track[]
  projects           Project[]
  trackPlays         TrackPlay[]
  playlists          Playlist[]
  albums             Album[]
  likedTracks        LikedTrack[]
  savedPlaylists     SavedPlaylist[]
  savedAlbums        SavedAlbum[]
  trackComments      TrackComment[]
  trackCommentLikes  TrackCommentLike[]

  followers            Follow[]       @relation("UserFollowers")
  following            Follow[]       @relation("UserFollowing")
  searchRecents        SearchRecent[]
  searchRecentTargets  SearchRecent[] @relation("SearchRecentTarget")
  conversationsLow     Conversation[] @relation("ConversationUserLow")
  conversationsHigh    Conversation[] @relation("ConversationUserHigh")
  conversationsStarted Conversation[] @relation("ConversationInitiator")
  messagesSent         Message[]
}

enum SearchRecentKind {
  ARTIST
  SONG
  ALBUM
  PLAYLIST
}

model Follow {
  id          String   @id @default(uuid(7)) @db.Uuid
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt(sort: Desc)])
  @@index([followerId, createdAt(sort: Desc)])
}

model SearchRecent {
  id           String           @id @default(uuid(7)) @db.Uuid
  userId       String           @db.Uuid
  kind         SearchRecentKind @default(ARTIST)
  /// Dedup key: artist user id, or media id for song/album/playlist
  targetKey    String
  targetUserId String?          @db.Uuid
  title        String?
  subtitle     String?
  coverUrl     String?
  query        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetUser User? @relation("SearchRecentTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, targetKey])
  @@index([userId, updatedAt(sort: Desc)])
}

enum TrackKind {
  SINGLE
  MULTI
}

enum TrackStatus {
  DRAFT
  PUBLISHED
}

enum TrackStorageState {
  LOCAL_ONLY
  SYNCED
  CLOUD_ONLY
}

model Track {
  id           String            @id @default(uuid(7)) @db.Uuid
  userId       String            @db.Uuid
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         TrackKind
  status       TrackStatus       @default(DRAFT)
  storageState TrackStorageState @default(LOCAL_ONLY)
  title        String
  durationMs   Int
  mixPath      String?
  /// Publish cover object key (Supabase now; swap adapter to R2 later)
  coverPath    String?
  caption      String?
  description  String?
  /// Curated ids from TRACK_GENRES (1–3). Validated in Zod, not a Postgres enum.
  genres       String[]          @default([])
  /// Free-text tags, max 5
  keywords     String[]          @default([])
  publishedAt  DateTime?
  /// Denormalized COUNT(TrackPlay); bumped when a play is recorded
  playCount    Int               @default(0)
  /// Denormalized COUNT(LikedTrack); bumped on like/unlike
  likeCount    Int               @default(0)
  /// Denormalized COUNT(TrackComment) including replies; bumped on create/delete
  commentCount Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  layers         TrackLayer[]
  projectLinks   ProjectTrack[]
  plays          TrackPlay[]
  playlistLinks  PlaylistTrack[]
  albumLink      AlbumTrack?
  likedBy        LikedTrack[]
  comments       TrackComment[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([userId, storageState])
  @@index([status, publishedAt(sort: Desc)])
}

/// Top-level or 1-level reply on a PUBLISHED track. Hard-delete; parent delete cascades replies.
model TrackComment {
  id        String   @id @default(uuid(7)) @db.Uuid
  trackId   String   @db.Uuid
  userId    String   @db.Uuid
  parentId  String?  @db.Uuid
  body      String
  likeCount Int      @default(0)
  createdAt DateTime @default(now())

  track    Track              @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   TrackComment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  TrackComment[]     @relation("CommentReplies")
  likes    TrackCommentLike[]

  @@index([trackId, createdAt(sort: Desc)])
  @@index([trackId, likeCount(sort: Desc), createdAt(sort: Desc)])
  @@index([parentId, createdAt(sort: Asc)])
  @@index([userId, createdAt(sort: Desc)])
}

model TrackCommentLike {
  id        String   @id @default(uuid(7)) @db.Uuid
  commentId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  comment TrackComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
}

model TrackPlay {
  id        String   @id @default(uuid(7)) @db.Uuid
  trackId   String   @db.Uuid
  userId    String   @db.Uuid
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([trackId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([trackId, userId, createdAt(sort: Desc)])
}

model Project {
  id          String         @id @default(uuid(7)) @db.Uuid
  userId      String         @db.Uuid
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tracks      ProjectTrack[]

  @@index([userId, updatedAt(sort: Desc)])
}

model ProjectTrack {
  id        String   @id @default(uuid(7)) @db.Uuid
  projectId String   @db.Uuid
  trackId   String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([projectId, trackId])
  @@index([projectId, addedAt(sort: Desc)])
  @@index([trackId])
}

enum PlaylistVisibility {
  PRIVATE
  PUBLIC
}

/// Listener-curated collection of any PUBLISHED tracks (Spotify-style).
model Playlist {
  id          String             @id @default(uuid(7)) @db.Uuid
  userId      String             @db.Uuid
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  coverPath   String?
  visibility  PlaylistVisibility @default(PRIVATE)
  saveCount   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tracks      PlaylistTrack[]
  savedBy     SavedPlaylist[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([visibility, updatedAt(sort: Desc)])
}

model PlaylistTrack {
  id         String   @id @default(uuid(7)) @db.Uuid
  playlistId String   @db.Uuid
  trackId    String   @db.Uuid
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  position   Int
  addedAt    DateTime @default(now())

  @@unique([playlistId, trackId])
  @@index([playlistId, position])
  @@index([trackId])
}

enum AlbumStatus {
  DRAFT
  RELEASED
}

/// Artist release grouping of own PUBLISHED tracks. One track → at most one album.
model Album {
  id          String      @id @default(uuid(7)) @db.Uuid
  userId      String      @db.Uuid
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  coverPath   String?
  status      AlbumStatus @default(DRAFT)
  releasedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tracks      AlbumTrack[]
  savedBy     SavedAlbum[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([status, releasedAt(sort: Desc)])
}

model AlbumTrack {
  id      String @id @default(uuid(7)) @db.Uuid
  albumId String @db.Uuid
  trackId String @db.Uuid
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  position Int
  addedAt  DateTime @default(now())

  @@unique([trackId])
  @@unique([albumId, trackId])
  @@index([albumId, position])
}

/// Viewer Liked Songs entry (Spotify-style heart). Own published tracks allowed.
model LikedTrack {
  id      String   @id @default(uuid(7)) @db.Uuid
  userId  String   @db.Uuid
  trackId String   @db.Uuid
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track   Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  likedAt DateTime @default(now())

  @@unique([userId, trackId])
  @@index([userId, likedAt(sort: Desc)])
  @@index([trackId])
}

/// Save of someone else's PUBLIC playlist. Own playlists never saved.
model SavedPlaylist {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  playlistId String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  savedAt    DateTime @default(now())

  @@unique([userId, playlistId])
  @@index([userId, savedAt(sort: Desc)])
  @@index([playlistId])
}

/// Save of someone else's RELEASED album. Own albums never saved.
model SavedAlbum {
  id      String   @id @default(uuid(7)) @db.Uuid
  userId  String   @db.Uuid
  albumId String   @db.Uuid
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  album   Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  savedAt DateTime @default(now())

  @@unique([userId, albumId])
  @@index([userId, savedAt(sort: Desc)])
  @@index([albumId])
}

model TrackLayer {
  id             String   @id @default(uuid(7)) @db.Uuid
  trackId        String   @db.Uuid
  track          Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  sortIndex      Int
  kind           String
  name           String
  stemPath       String?
  sourcePath     String?
  offsetMs       Int      @default(0)
  durationMs     Int
  muted          Boolean  @default(false)
  appliedEffects Json     @default("[]")
  peaks          Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([trackId, sortIndex])
}

enum ConversationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum MessageType {
  TEXT
  AUDIO
}

/// Ccanonical pair, lexicographically lower UUID first so (A,B) == (B,A)
model Conversation {
  id            String             @id @default(uuid(7)) @db.Uuid
  userLowId     String             @db.Uuid
  userHighId    String             @db.Uuid
  status        ConversationStatus @default(PENDING)
  initiatedById String             @db.Uuid
  lastMessageAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  userLow     User      @relation("ConversationUserLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh    User      @relation("ConversationUserHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  initiatedBy User      @relation("ConversationInitiator", fields: [initiatedById], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([userLowId, userHighId])
  @@index([userLowId, status, lastMessageAt(sort: Desc)])
  @@index([userHighId, status, lastMessageAt(sort: Desc)])
  @@index([initiatedById, status])
}

model Message {
  id             String      @id @default(uuid(7)) @db.Uuid
  conversationId String      @db.Uuid
  senderId       String      @db.Uuid
  type           MessageType
  body           String?
  audioPath      String?
  durationMs     Int?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId, createdAt(sort: Desc)])
}

model PasswordResetChallenge {
  id         String   @id @default(uuid(7)) @db.Uuid
  email      String   @unique
  codeHash   String
  attempts   Int      @default(0)
  expiresAt  DateTime
  lastSentAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([expiresAt])
}
