generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  email              String    @unique
  username           String    @unique
  password           String
  name               String?
  bio                String?
  avatarPath         String?
  coverPath          String?
  usernameChangedAt  DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tracks             Track[]

  followers            Follow[]       @relation("UserFollowers")
  following            Follow[]       @relation("UserFollowing")
  searchRecents        SearchRecent[]
  searchRecentTargets  SearchRecent[] @relation("SearchRecentTarget")
  conversationsLow     Conversation[] @relation("ConversationUserLow")
  conversationsHigh    Conversation[] @relation("ConversationUserHigh")
  conversationsStarted Conversation[] @relation("ConversationInitiator")
  messagesSent         Message[]
}

enum SearchRecentKind {
  ARTIST
  SONG
  ALBUM
  PLAYLIST
}

model Follow {
  id          String   @id @default(uuid(7)) @db.Uuid
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt(sort: Desc)])
  @@index([followerId, createdAt(sort: Desc)])
}

model SearchRecent {
  id           String           @id @default(uuid(7)) @db.Uuid
  userId       String           @db.Uuid
  kind         SearchRecentKind @default(ARTIST)
  /// Dedup key: artist user id, or media id for song/album/playlist
  targetKey    String
  targetUserId String?          @db.Uuid
  title        String?
  subtitle     String?
  coverUrl     String?
  query        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetUser User? @relation("SearchRecentTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, targetKey])
  @@index([userId, updatedAt(sort: Desc)])
}

enum TrackKind {
  SINGLE
  MULTI
}

enum TrackStatus {
  DRAFT
  PUBLISHED
}

enum TrackStorageState {
  LOCAL_ONLY
  SYNCED
  CLOUD_ONLY
}

model Track {
  id           String            @id @default(uuid(7)) @db.Uuid
  userId       String            @db.Uuid
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         TrackKind
  status       TrackStatus       @default(DRAFT)
  storageState TrackStorageState @default(LOCAL_ONLY)
  title        String
  durationMs   Int
  mixPath      String?
  publishedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  layers       TrackLayer[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([userId, storageState])
}

model TrackLayer {
  id             String   @id @default(uuid(7)) @db.Uuid
  trackId        String   @db.Uuid
  track          Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  sortIndex      Int
  kind           String
  name           String
  stemPath       String?
  sourcePath     String?
  offsetMs       Int      @default(0)
  durationMs     Int
  muted          Boolean  @default(false)
  appliedEffects Json     @default("[]")
  peaks          Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([trackId, sortIndex])
}

enum ConversationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum MessageType {
  TEXT
  AUDIO
}

/// Ccanonical pair, lexicographically lower UUID first so (A,B) == (B,A)
model Conversation {
  id            String             @id @default(uuid(7)) @db.Uuid
  userLowId     String             @db.Uuid
  userHighId    String             @db.Uuid
  status        ConversationStatus @default(PENDING)
  initiatedById String             @db.Uuid
  lastMessageAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  userLow     User      @relation("ConversationUserLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh    User      @relation("ConversationUserHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  initiatedBy User      @relation("ConversationInitiator", fields: [initiatedById], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([userLowId, userHighId])
  @@index([userLowId, status, lastMessageAt(sort: Desc)])
  @@index([userHighId, status, lastMessageAt(sort: Desc)])
  @@index([initiatedById, status])
}

model Message {
  id             String      @id @default(uuid(7)) @db.Uuid
  conversationId String      @db.Uuid
  senderId       String      @db.Uuid
  type           MessageType
  body           String?
  audioPath      String?
  durationMs     Int?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId, createdAt(sort: Desc)])
}
