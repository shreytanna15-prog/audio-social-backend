generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid(7)) @db.Uuid
  email     String   @unique
  username  String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tracks    Track[]

  followers           Follow[]       @relation("UserFollowers")
  following           Follow[]       @relation("UserFollowing")
  searchRecents       SearchRecent[]
  searchRecentTargets SearchRecent[] @relation("SearchRecentTarget")
}

enum SearchRecentKind {
  ARTIST
  SONG
  ALBUM
  PLAYLIST
}

model Follow {
  id          String   @id @default(uuid(7)) @db.Uuid
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt(sort: Desc)])
  @@index([followerId, createdAt(sort: Desc)])
}

model SearchRecent {
  id           String           @id @default(uuid(7)) @db.Uuid
  userId       String           @db.Uuid
  kind         SearchRecentKind @default(ARTIST)
  /// Dedup key: artist user id, or media id for song/album/playlist
  targetKey    String
  targetUserId String?          @db.Uuid
  title        String?
  subtitle     String?
  coverUrl     String?
  query        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetUser User? @relation("SearchRecentTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, targetKey])
  @@index([userId, updatedAt(sort: Desc)])
}

enum TrackKind {
  SINGLE
  MULTI
}

enum TrackStatus {
  DRAFT
  PUBLISHED
}

enum TrackStorageState {
  LOCAL_ONLY
  SYNCED
  CLOUD_ONLY
}

model Track {
  id           String            @id @default(uuid(7)) @db.Uuid
  userId       String            @db.Uuid
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         TrackKind
  status       TrackStatus       @default(DRAFT)
  storageState TrackStorageState @default(LOCAL_ONLY)
  title        String
  durationMs   Int
  mixPath      String?
  publishedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  layers       TrackLayer[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([userId, storageState])
}

model TrackLayer {
  id             String   @id @default(uuid(7)) @db.Uuid
  trackId        String   @db.Uuid
  track          Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  sortIndex      Int
  kind           String
  name           String
  stemPath       String?
  sourcePath     String?
  offsetMs       Int      @default(0)
  durationMs     Int
  muted          Boolean  @default(false)
  appliedEffects Json     @default("[]")
  peaks          Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([trackId, sortIndex])
}
